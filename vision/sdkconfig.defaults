# Settings applied when sdkconfig is (re)generated. Put project settings here
# rather than relying only on menuconfig, so they survive a clean rebuild.

# Target chip. Without this, a missing sdkconfig falls back to plain esp32
# (Xtensa), whose toolchain isn't installed.
CONFIG_IDF_TARGET="esp32p4"

# ESP32-P4 chip revision: check it when the board arrives (esptool prints
# "Chip is ESP32-P4 (revision vX.Y)" on connect).
#   v3.x (default): leave this commented out.
#   v1.x: uncomment the next line, then delete sdkconfig and the build folder.
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

# Flash: the P4-NANO has 16MB.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Partition table: app + model layout, see partitions.csv.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM: on by default for the P4, pinned here so it can't silently drop out.
CONFIG_SPIRAM=y

# FAT long filenames, buffer on the heap (an alloc failure is a returned
# error; a stack overflow is a crash).
CONFIG_FATFS_LFN_HEAP=y

# Camera: OV5647 over 2-lane MIPI-CSI, through the P4's ISP (esp_video).
# 1280x960 binning is RAW10 off the sensor; the ISP converts it to the
# pixel format camera.c asks for.
CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_MIPI_RAW10_1280X960_BINNING_45FPS=y
CONFIG_CAMERA_OV5647_MIPI_DEFAULT_FMT_RAW10_1280X960_BINNING_45FPS=y
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP=y
CONFIG_ESP_VIDEO_ENABLE_ISP_VIDEO_DEVICE=y

# ---- Firmware updates over Wi-Fi (components/wifi_ota) ----
# These two are baked into the bootloader / flash layout by the USB flash; an over-the-air
# update can't change them later.
# Rollback: a freshly updated app boots "pending verify"; if it resets before wifi_ota.c
# confirms it, the bootloader boots the previous app instead.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Partition table at 0x10000 instead of 0x8000: bootloader headroom (see partitions.csv).
CONFIG_PARTITION_TABLE_OFFSET=0x10000

# Wi-Fi goes through the onboard ESP32-C6 (esp_hosted over SDIO, slot 1). Pins are the
# P4-NANO's wiring (also esp_hosted's P4 defaults; pinned here so a default change can't move them).
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
# A dead or misbehaving C6 must never reboot the vision board: by default esp_hosted restarts
# the whole P4 on an SDIO transport failure. wifi_ota.c handles the failure event instead.
# CONFIG_ESP_HOSTED_TRANSPORT_RESTART_ON_FAILURE is not set
